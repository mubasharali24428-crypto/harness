# ============================================================================
# Harness — environment template
#
# Copy to `.env` next to this file and edit; docker-compose reads it
# automatically:
#
#     cp .env.example .env
#
# NOTE (Docker Compose quirk): when you invoke
# `docker compose -f deploy/docker-compose.yml …` from the repo ROOT, some
# Compose versions do NOT load this root `.env` — pass it explicitly:
#
#     docker compose --env-file .env -f deploy/docker-compose.yml up -d
#
# Every variable below is read by `deploy/runners/services.py` or referenced
# in `deploy/docker-compose.yml` (verified 2026-08-23, Mission 12 G4).
# "Required" means the stack refuses to boot / the feature fails without it.
# Secrets: never commit your real `.env`; it is gitignored on purpose.
# ============================================================================

# ----------------------------------------------------------------------------
# Core — REQUIRED for any real boot
# ----------------------------------------------------------------------------

# 32+ byte secret used to encrypt API keys + GitHub tokens at rest (KeyVault).
# Generate with: openssl rand -hex 32
# services.py fail-fasts (refuses to start) when this is empty or the known
# dev placeholder, unless HARNESS_ALLOW_DEV_MASTER_KEY=1 (below). Rotating it
# invalidates previously encrypted secrets — re-mint API keys / reconnect
# GitHub afterwards. SECRET — treat like a password.
HARNESS_MASTER_KEY=

# Explicit dev opt-out of the master-key check above. Leave unset everywhere
# except throwaway local development. NEVER set in anything shared.
# HARNESS_ALLOW_DEV_MASTER_KEY=1

# ----------------------------------------------------------------------------
# Engine

# Engine runtime patches (optional, os.pathsep-separated). OpenRouter's endpoint
# is OpenAI-compatible, but the bundled dsh runtime defaults to the Anthropic
# Messages API, so OpenRouter needs the transport patch:
#   DSH_PATCH_FILES=/opt/harness/patches/openrouter.patch.yml
# (the orchestrator container mounts deploy/patches there read-only). DSH_MODEL
# is required by that patch and must be the OpenRouter model id.
# DSH_PATCH_FILES=

# W4 slice 3: operator-reviewed MCP servers (optional). The JSON lists stdio or
# https servers; the engine refuses a malformed entry, a non-https URL, any
# credential-bearing header, and any env at all on a spawned server. The file is
# baked into the worker image (/opt/harness/mcp), so reviewing a server means a
# rebuild — deploy/mcp/servers.stub.json is the first-party stub used by the drill.
#   DSH_MCP_SERVERS=/opt/harness/mcp/servers.stub.json
# DSH_MCP_SERVERS=

# W4 slice 4: allow package installs (pip/npm/yarn/pnpm) inside a run. Off by
# default; when set, the verbs are permitted only under the container boundary and
# the worker's traffic is routed through the egress proxy, so an install can only
# reach the derived registry list (pypi/npmjs + the allow-list's registries). It
# still fetches unvetted code — the flag trades that risk for the boundary, it does
# not remove it.
# DSH_ALLOW_INSTALLS=1

# Upper bound for one isolated engine worker call. On expiry the worker's
# process group is killed and the run reports an honest error. Default 900.
# HARNESS_ENGINE_TIMEOUT_SECONDS=900

# Database
# ----------------------------------------------------------------------------

# Section 5 per-task Docker runner. Keep disabled in the shared Compose
# backend. Enabling it requires a dedicated/isolated Docker daemon and a
# pre-pulled immutable worker image; an empty image value fails closed.
# SANDBOX_USE_DOCKER=false
# SANDBOX_DEFAULT_DOCKER_IMAGE=registry.example.invalid/harness-worker@sha256:<digest>
# HARNESS_SANDBOX_ALLOW_NETWORK=0

# SQLAlchemy async DSN. Compose hardcodes the in-network value; override only
# for host-run backends or tests. From the host, the compose Postgres is on
# localhost:5499 (NOT 5432 — that port stays free for a local Postgres).
# Default: postgresql+asyncpg://harness:harness@db:5432/harness
# HARNESS_DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5499/harness

# Password for the compose `db` container itself; also picked up by the walg
# backup sidecar. Dev default: harness
# POSTGRES_PASSWORD=harness

# ----------------------------------------------------------------------------
# Postgres server tuning (`db` command flags, M17-B2 / OPS-08/09)
# ----------------------------------------------------------------------------
#
# The compose `db` service passes these to postgres as `-c name=${VAR:-def}`
# flags (see deploy/docker-compose.yml). Defaults below are chosen for this
# stack's churn profile: agent_events/rate_buckets/audit_log get steady
# INSERT/DELETE traffic (events-retention sweeps + per-request rate buckets),
# so vacuum runs often and triggers on small dead-row fractions instead of
# the stock 20%-of-table threshold that lets append-heavy tables bloat for
# hours between passes. Leave unset for the defaults; override only with a
# reason (and re-read docs/runbooks/maintenance.md after changing vacuum
# behavior).

# Seconds between autovacuum wakes across the whole cluster. Stock 60s;
# 30s halves worst-case dead-tuple latency on the churn tables at negligible
# cost for a dev-sized instance.
# PG_AUTOVACUUM_NAPTIME=30s

# Fraction of dead rows (relative to table size) that triggers an autovacuum.
# Stock 0.2 lets a large table accumulate 20% garbage before action; 0.05
# keeps agent_events lean between retention sweeps.
# PG_AUTOVACUUM_VACUUM_SCALE=0.05

# Fraction of inserted/updated rows that triggers auto-ANALYZE so planner
# statistics stay fresh on fast-moving tables. Stock 0.1; 0.02 suits tables
# that grow by thousands of rows per hour.
# PG_AUTOVACUUM_ANALYZE_SCALE=0.02

# Concurrent autovacuum worker processes. Stock 3; 5 lets the three documented
# churn tables be worked in parallel without queueing behind each other.
# PG_AUTOVACUUM_MAX_WORKERS=5

# ----------------------------------------------------------------------------
# HTTP surface
# ----------------------------------------------------------------------------

# Browser origins allowed to call the backends (credentials are sent, so
# wildcards are refused). Accepts a JSON array (compose convention) or a
# comma-separated list. Default: ["http://localhost:3000"]
# HARNESS_CORS_ORIGINS=["http://localhost:3000"]

# Set to 1 only when TLS terminates in front of the stack (e.g. the `proxy`
# profile / harness.local Caddy): enables HSTS. Default: off.
# HARNESS_TLS_ENABLED=1

# CSP rollout ladder (M15-W5-S1). DEFAULT/OFF: HTML responses carry
# `Content-Security-Policy-Report-Only` — browsers EVALUATE the policy and
# POST violations to the identity service's /api/v1/csp-report collector
# (logged, no PII) but BLOCK nothing, so pages keep working while you watch
# the report stream for a clean window.
#
# Set true ONLY AFTER that report-only run is clean: the same policy then
# ships on the enforcing `Content-Security-Policy` header and violations are
# actually blocked. Accepts 1/true/yes/on. Default: off (report-only).
# The shipped policy covers what the UI really loads: scripts 'self'
# (bundled JS — no inline scripts), styles 'self' 'unsafe-inline' (React
# style attributes), img data:/blob:, and connect-src listing the local
# section API origins + ws:/wss: for the event stream. Custom deployments
# with different API origins: extend HARNESS_CSP_EXTRA_ORIGINS (JSON array,
# merged into connect-src; wildcards refused).
# HARNESS_CSP_ENFORCE=true
# HARNESS_CSP_EXTRA_ORIGINS=["https://api.example.com"]

# ----------------------------------------------------------------------------
# Authentication / ownership proof (C-001)
# ----------------------------------------------------------------------------

# true (default since M11-W1): an email must verify via OTP before it can
# mint/own a team — plain login gets 403 OWNERSHIP_REQUIRED. false restores
# the legacy type-any-email dev login. Keep true for anything exposed.
# HARNESS_REQUIRE_OWNERSHIP=true

# I-09 verification-first (P-11): a human done-signal is rejected
# (400 VERIFICATION_REQUIRED) unless the run recorded a test command going
# green, read server-side from agent_tool_calls — never a caller-asserted
# string. Default true since the 2026-11-14 decision
# (docs/decisions/2026-11-14-verification-first-default-on.md): "done" means
# "verified", not merely "diff attached". Set false only for dry-mode/demo
# flows that record no live tests (e.g. the owner demo stack, golden
# conformance fixtures) — those deployments must pin it explicitly.
# HARNESS_VERIFICATION_FIRST=true

# P-15 verdict comment CLI (python -m harness_orchestrator.verdict_post RUN_ID): reads one run's
# recorded facts and posts an ADVISORY comment on its PR through the GitHub service (never an
# approval; a human merges; needs the project's GitHub write opt-in). The comment appears under
# the connected GitHub user's account. GITHUB_URL default http://localhost:8002, REVIEW_URL
# (path-risk flags) default http://localhost:8008; API_TOKEN is the caller's session token
# (kept in the environment, never printed; the comment builder scrubs it).
# HARNESS_GITHUB_URL=http://localhost:8002
# HARNESS_REVIEW_URL=http://localhost:8008
# HARNESS_API_TOKEN=

# Email delivery for OTP codes + run notifications (see notifier worker).
# Host unset → OTP codes print to the identity container's logs as
# `HARNESS-OTP ...` (dev mode) and notifications are logged, not sent.
# HARNESS_SMTP_HOST=
# HARNESS_SMTP_PORT=587
# HARNESS_SMTP_USERNAME=
# HARNESS_SMTP_PASSWORD=
# HARNESS_SMTP_FROM=harness@noreply.local
# HARNESS_SMTP_STARTTLS=true

# Alert email recipient for the `alertmanager` service (profile observability);
# it reuses the SMTP settings above and refuses to start without this.
# HARNESS_ALERT_EMAIL_TO=
# Optional second alert channel: Alertmanager also POSTs every alert (webhook JSON) to this URL.
# HARNESS_ALERT_WEBHOOK_URL=

# Recipient for run/review/PR notification emails. Unset → notifications off
# (outbox rows are never enqueued); per-event notifyEmail overrides win.
# HARNESS_NOTIFY_EMAIL=

# ----------------------------------------------------------------------------
# GitHub OAuth (S2 repo connect) — REQUIRES OPERATOR-PROVIDED VALUES
# ----------------------------------------------------------------------------

# There is no built-in OAuth app. Register your own at
# https://github.com/settings/developers (callback URL must equal
# HARNESS_GITHUB_REDIRECT_URI below) and fill these in — until then GitHub
# connect returns 503 NOT_CONFIGURED. See deploy/ONBOARDING.md.
# Compose maps GITHUB_CLIENT_ID/SECRET onto S2's HARNESS_-prefixed settings
# (HARNESS_GITHUB_CLIENT_ID, HARNESS_GITHUB_CLIENT_SECRET, plus
# FRONTEND_BASE → HARNESS_FRONTEND_BASE and GITHUB_REDIRECT_URI →
# HARNESS_GITHUB_REDIRECT_URI), so set the well-known names here:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the OAuth app's callback URL exactly:
# GITHUB_REDIRECT_URI=http://localhost:8002/api/v1/github/oauth/callback
# Where OAuth redirects land in the frontend:
# FRONTEND_BASE=http://localhost:3000

# ----------------------------------------------------------------------------
# Engine (Section 4 execution backend)
# ----------------------------------------------------------------------------

# live = runs go through a real model provider; dry = honest stub executor.
# UNSET is a deploy failure by design (M11-W1-B1): the engine never guesses.
# In compose the host-unset default is `dry`.
ENGINE_LIVE_MODE=dry

# Provider credentials for LIVE mode (OpenAI-compatible endpoint).
# DEEPSEEK_BASE_URL example for local Ollama: http://host.docker.internal:11434/v1
# SECRET — never commit. Required when ENGINE_LIVE_MODE=live.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Model the engine drives in live mode (required for live).
DSH_MODEL=

# W14/W15: operator rate card, merged over the built-in price list. It is a
# BACKEND value, not a models-only one: the router quotes from it AND Section 4
# books engine spend through the same resolution (card -> catalog -> logged
# fallback), so a model is never quoted one rate and booked at another.
# Inline JSON or a path readable inside the container. A model the card and the
# catalog both lack is reported `unpriced` by the router (bills 0 there) and
# metered at the fallback rate by the ledger, with a warning naming the model.
# Example: {"models": {"openai/gpt-5": {"input": 1.25, "output": 10}}}
# Set it in the SAME env file you recreate with: `--env-file` replaces compose's
# default `.env` lookup, so a service recreated against another file boots
# without the card and prices from the catalog while its peers price from the
# card (seen live 2026-10-29; guarded by
# section1/tests/test_deploy_observability.py::test_every_backend_service_inherits_the_pricing_and_budget_knobs).
HARNESS_RATE_CARD_JSON=

# M07: live runs are confined by worker-daemon, which alone holds the Docker socket:
#   docker compose -f deploy/docker-compose.yml --profile worker up -d
# Shared by the orchestrator and the daemon; without it live runs fail closed.
# SECRET — never commit. Generate with: openssl rand -hex 32
HARNESS_WORKER_DAEMON_TOKEN=

# Engine workspace/session storage inside containers (rarely overridden;
# the orchestrator itself uses the harness_runs volume, see M07 above):
DSH_WORKSPACE=/tmp/harness-dsh/workspace
DSH_SESSION_ROOT=/tmp/harness-dsh/sessions

# Optional pre-flight validator (prints variable NAMES, never secret values):
#   python deploy/runners/engine_boot.py && docker compose -f deploy/docker-compose.yml up -d

# ----------------------------------------------------------------------------
# Orchestrator tuning
# ----------------------------------------------------------------------------

# Max concurrently EXECUTING runs per team. Default: 4
# HARNESS_RUN_CONCURRENCY=4
#
# M17-B5: engine runs execute on a dedicated bounded executor. This bound is
# the REAL process-wide engine concurrency; per-team caps above are only
# honest up to it (see docs/engine-concurrency.md for the pool math).
# Default 8 = shipped per-team cap (4) × 2 seeded teams.
# ENGINE_MAX_CONCURRENCY=8
#
# Hard wall-clock deadline for ONE engine run, seconds. A run that exceeds it
# fails honestly (engine_failed reason=timeout) and its queue claim is
# released. Default: 600.
# ENGINE_RUN_TIMEOUT_SECONDS=600
#
# Hung-provider circuit breaker: after this many CONSECUTIVE timeouts on one
# provider|model, further runs targeting it fail fast until cool-down ends.
# Defaults: 3 consecutive timeouts, 300s cool-down.
# ENGINE_BREAKER_THRESHOLD=3
# ENGINE_BREAKER_COOLDOWN_SECONDS=300
# Run-queue worker poll interval, seconds. Default: 0.5
# HARNESS_WORKER_POLL_SECONDS=0.5
# Notification outbox drain interval, seconds. Default: 30
# HARNESS_NOTIFY_POLL_SECONDS=30
#
# W28: the orchestrator's two repeated-denial stops (loop_guard.py). A denial is
# a shell-policy refusal, NOT a timeout or a merely failed command.
# 3 denials IN A ROW stop the run as denials_repeated. Default: 3.
# Setting 0, empty or off turns this stop off, a positive number is the limit, and
# a non-number falls back to the default.
# HARNESS_DENIAL_RUN_LIMIT=3
#
# 10 denials within the last 50 tool RESULTS stop the run. Default: 10.
# Setting 0, empty or off turns this stop off, a positive number is the limit, and
# a non-number falls back to the default.
# The 50-result window itself is not tunable here.
# HARNESS_DENIAL_WINDOW_LIMIT=10

# Run-claim heartbeat staleness threshold, seconds. A running claim whose
# stored heartbeat_at is older than this (by the DB's clock) belongs to a
# dead worker: the zombie reaper releases it, moves the run to BLOCKED and
# emits engine_failed {reason: heartbeat_lost}. Default: 90 (= 9 missed
# beats at the service's ~10s heartbeat interval). Non-integer values are
# ignored with a warning (M13-H1b).
# HEARTBEAT_TIMEOUT_SECONDS=90

# Fallback per-team spend cap (USD) when teams.budget_usd is not set.
# Unset/garbage → unlimited. Per-team DB value wins over this.
# HARNESS_TEAM_BUDGET_USD=
#
# W18: the two PUBLISHED tier caps (PRICING.md §1). These tune the shipped
# defaults deploy-wide (free: 20 runs/day, 2000 context chunks); they can
# tighten a capped tier, never bound an unlimited one, and a per-team
# billing_plans override always wins. Garbage/unset falls through to the
# tier default.
# HARNESS_TIER_RUNS_PER_DAY=20
# HARNESS_TIER_CONTEXT_CHUNKS=2000
#
# W15: TEAM-keyed HTTP budgets on the two spend surfaces, per minute, stored in
# the shared rate_buckets table (same store as the per-IP limiter; a store
# outage fails OPEN). Unset/blank/non-positive keeps the shipped defaults.
# Run start (agent spawn) is limited per team at 60/min; model calls (provider
# spend) at 300/min. These are abuse guards, not UX blockers.
# HARNESS_TEAM_RUN_START_LIMIT=60
# HARNESS_TEAM_MODEL_CALL_LIMIT=300
# W28 S1: delegate verb (POST .../delegations — mint child assignments for a
# run). Default off: unset reads as disabled and the route answers 403
# SUBAGENTS_DISABLED before writing any ledger row. Set to 1 to enable.
# HARNESS_SUBAGENTS=1

# ----------------------------------------------------------------------------
# Billing (Mission 10)
# ----------------------------------------------------------------------------

# off/unset → billing endpoints render the honest upsell state; "local" →
# quota from cost_ledger vs teams.budget_usd; "stripe" → additionally requires
# STRIPE_API_KEY (below), else degrades to local.
# HARNESS_BILLING=
# STRIPE_API_KEY=

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------

# Orchestrator log pipeline: json (default) | console.
# HARNESS_LOG_FORMAT=json
# Log level for the same pipeline. Default: INFO
# HARNESS_LOG_LEVEL=INFO
# Refresh cadence (seconds) for the orchestrator's DB-backed /metrics gauges
# (queue depth, event-bus lag, pool saturation, and the W14 cost/latency
# rollups the cost dashboard reads). 0 disables the poller.
# HARNESS_METRICS_DB_POLL_SECONDS=15
# Rolling window (hours) for the model latency p50/p95 gauges. Non-numeric or
# non-positive values fall back to 24 rather than blanking the series. The
# month-to-date spend gauge is NOT windowed — it follows the DB clock's month.
# HARNESS_COST_METRICS_WINDOW_HOURS=24

# ----------------------------------------------------------------------------
# Backup / PITR (H-018 M13-W3-H2; topology updated M17-B2 / OPS-01)
# ----------------------------------------------------------------------------
#
# Since M17-B2 the LIVE `db` service itself archives WAL (archive_mode=on +
# archive_command='wal-g wal-push %p' on the harness-db-walg image) — these
# variables feed THAT archiver directly. The `--profile walg` services are:
# `walg-db`, a drill/rehearsal Postgres with its own throwaway pgdata_walg
# volume, and `walg`, the one-shot base-backup wrapper whose PGHOST now
# DEFAULTS TO THE LIVE `db`. See docs/runbooks/backup-and-pitr.md.

# Storage target: exactly ONE prefix is required before archiving/backups
# produce anything. Until one is set, the live db logs a failed wal-push for
# every segment (watch pg_stat_archiver.failed_count).
# WALG_S3_PREFIX=s3://harness-bucket/pg       # or:
# WALG_FILE_PREFIX=/some/local/dir            # file:// backend for drills (no cloud)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT=                               # MinIO/R2-compatible endpoint
# WALG_COMPRESSION_METHOD=lz4                 # lz4|gzip|brotli|zstd|none
# WALG_RETENTION_KEEP=7                       # 0 disables pruning
# WALG_ARCHIVE_TIMEOUT=60s                    # segment force-switch; bounds RPO on a quiet db
# WALG_IMAGE_TAG=v3.0.9                       # harness-db-walg tag (= Dockerfile.walg WALG_VERSION)
# BACKUP_MODE=base                            # base|wal|list|retention|config (legacy: WALG_MODE)
# WALG_PGHOST=db                              # backup source; 'walg-db' = drill sidecar for rehearsals
# WALG_LIST_JSON=1                            # backup-list --json
# WALG_EXTRA_ARGS=                            # appended verbatim to wal-g invocations
# BACKUP_MIN_WAL_SECONDS=600                  # warn if archiver idle this long after a base
# BACKUP_STRICT=1                             # escalate that warning to exit 1

# ----------------------------------------------------------------------------
# agent_events retention sweep (`events-retention` service, M12-G1)
# ----------------------------------------------------------------------------

# Default-on sidecar (it also creates agent_events month partitions, without
# which event inserts fail) that deletes agent_events rows older than RETENTION_DAYS in
# BATCH_SIZE chunks (separate short transactions, so a backlog never holds a
# long lock). `loop` sweeps every RUN_INTERVAL_SECONDS; `once` exits after a
# single sweep (pair with host cron for exact timing).
# EVENTS_RETENTION_MODE=loop                 # loop|once
# RETENTION_DAYS=30
# BATCH_SIZE=5000
# RUN_INTERVAL_SECONDS=21600                 # four sweeps a day

# ----------------------------------------------------------------------------
# Scheduled VACUUM / ANALYZE (`--profile maintenance`, M15-W5-D2)
# ----------------------------------------------------------------------------

# Weekly VACUUM (ANALYZE) on the highest-churn tables, driven by
# scripts/maintenance.sh on the stock postgres image; loop mode runs one pass
# at startup then every MAINTENANCE_INTERVAL_SECONDS. Reindexing is OFF by
# default (MAINTENANCE_REINDEX=1 enables REINDEX TABLE CONCURRENTLY).
# Runbook: docs/runbooks/maintenance.md.
# MAINTENANCE_MODE=loop                      # loop|once
# MAINTENANCE_INTERVAL_SECONDS=604800        # one week
# MAINTENANCE_TABLES="agent_events rate_buckets audit_log"
# MAINTENANCE_REINDEX=0

# ----------------------------------------------------------------------------
# Container resource limits + log rotation (M20-T3, S-GAMMA OPS-03/OPS-04)
# ----------------------------------------------------------------------------

# Every compose service is bounded (mem / cpus / pids) so a runaway container
# can never starve Postgres again. Defaults below; retune per deployment here,
# never by editing docker-compose.yml. Runbook: docs/runbooks/ops.md §3.1.
# HARNESS_DB_MEM_LIMIT=1g          # db (+walg-db, db-loadtest)
# HARNESS_DB_CPU_LIMIT=1.0
# HARNESS_DB_PIDS_LIMIT=512
# HARNESS_ORCH_MEM_LIMIT=768m      # orchestrator (+legacy backend, loadtest twin): engine subprocesses
# HARNESS_ORCH_CPU_LIMIT=1.0
# HARNESS_ORCH_PIDS_LIMIT=256
# HARNESS_SANDBOX_MEM_LIMIT=768m   # sandbox: executes agent code by design
# HARNESS_SANDBOX_CPU_LIMIT=1.0
# HARNESS_SANDBOX_PIDS_LIMIT=256
# HARNESS_APP_MEM_LIMIT=384M       # github/models/meeting/review (+identity-loadtest)
# HARNESS_APP_CPU_LIMIT=0.50
# HARNESS_APP_PIDS_LIMIT=128
# HARNESS_FRONTEND_MEM_LIMIT=512m  # Next.js SSR
# HARNESS_FRONTEND_CPU_LIMIT=0.50
# HARNESS_FRONTEND_PIDS_LIMIT=192
# HARNESS_JOB_MEM_LIMIT=256m       # migrate/events-retention/cost-rollup/db-maintenance/prometheus-pids
# HARNESS_JOB_CPU_LIMIT=0.25
# HARNESS_JOB_PIDS_LIMIT=64
# HARNESS_WALG_CPU_LIMIT=0.50      # backup wrapper (mem fixed 512m)
# HARNESS_PROXY_MEM_LIMIT=128m     # Caddy (cpu fixed 0.25)
# HARNESS_PROM_CPU_LIMIT=0.50      # Prometheus (mem fixed 512m)

# Log driver caps on EVERY service: json-file, max-size x max-file per
# container (<=30 MiB each at defaults). Prevents the slow-motion disk
# exhaustion S-GAMMA flagged on the same disk holding pgdata.
# HARNESS_LOG_MAX_SIZE=10m
# HARNESS_LOG_MAX_FILE=3

# ----------------------------------------------------------------------------
# Runtime behaviour, safety boundaries and retention (W15 gap fill 2026-10-29)
#
# Every knob in this section is READ BY THE CODE TODAY but was absent from this
# file — an operator could not discover it without reading Python. `make
# check-env-knobs` (CI: static-gates job) fails if a `HARNESS_*` variable is
# read anywhere in section*/src, contracts/src or deploy/runners and is not
# documented here, so the catalogue cannot rot again. Defaults below are quoted
# from the read sites; unset therefore means exactly the stated default.
# ----------------------------------------------------------------------------

# --- Confinement and tool gates (Section 5 sandbox + Section 4 engine) -----
# Which OS boundary the sandbox uses: auto|container|seatbelt|required|off.
# Keep auto in a pilot deployment: on Linux the boundary fails CLOSED because
# Landlock write confinement does not yet deny forbidden-path READS, and an
# explicit off is a diagnostics-only escape hatch (see the flag below).
HARNESS_SANDBOX_CONFINEMENT=auto
# conformance=off is a dev escape hatch and REFUSES to start unless this is
# 1/true/yes (SecurityPolicyViolationError, logged). Never set in production.
HARNESS_SANDBOX_ALLOW_UNCONFINED=
# Network egress from the sandbox stays an explicit opt-in.
HARNESS_SANDBOX_ALLOW_NETWORK=0
# Host:port the confined worker daemon listens on (0.0.0.0 is the container
# default; the daemon alone holds the Docker socket).
HARNESS_WORKER_DAEMON_BIND=0.0.0.0:8010
# Stale-boundary sweep cadence inside the daemon (seconds; 0 disables).
HARNESS_BOUNDARY_SWEEP_SECONDS=600
# Subprocess isolation of SDK calls. Tests and the worker itself set 0; leave
# the default 1 in a deployment.
HARNESS_ENGINE_ISOLATED=1
# Wall-clock kill budget per confined engine worker run (seconds).
HARNESS_ENGINE_TIMEOUT_SECONDS=900
# Container image the engine workers come from (compose overrides per tag).
HARNESS_ENGINE_IMAGE=harness-engine-worker:p0
# Path of each tool gate script mounted into the worker; the worker Dockerfile
# sets these to the repo copies — override only to substitute a stricter gate.
HARNESS_SHELL_GATE=
HARNESS_WEB_GATE=
HARNESS_BROWSER_GATE=
HARNESS_IMAGE_GATE=
# Egress proxy handed to the web/browser plugins (the allow-list boundary).
# Set only when the sandbox-egress service is deployed.
HARNESS_WEB_PROXY_URL=
# Chromium binary for the browser gate; unset falls back to `which chromium`.
HARNESS_CHROMIUM=
# Append the repo baseline block to every goal (0 turns context injection off).
HARNESS_REPO_CONTEXT=1
# Operator-prepared checkout copied into new run workspaces (empty = none).
HARNESS_WORKSPACE_SEED=
# Per-turn output-token ceiling for the SDK ("for cost control"); unset lets
# the provider decide.
HARNESS_SDK_MAX_TOKENS=

# --- Goal images (Section 4 vision path) -----------------------------------
# Kill switch, ON by default: 0/off/false/no stops images ever being attached.
HARNESS_GOAL_IMAGES=1
# Comma-separated vision-capable model ids. Unset means no LOCAL refusal — the
# provider stays the authority and its rejection is surfaced as the reason.
HARNESS_VISION_MODELS=

# --- Orchestration cadence and budgets -------------------------------------
# Per-team concurrent-run ceiling (the admission cap the fairness order works
# inside; `billing_plans.concurrent_runs_override` wins per plan).
HARNESS_RUN_CONCURRENCY=4
# How often an idle queue worker polls for claims (seconds).
HARNESS_WORKER_POLL_SECONDS=0.5
# Pauses runs that hit their limits (0 disables the sweeper).
HARNESS_LIMIT_SWEEP_SECONDS=30
# Pauses runs belonging to a paused session (0 disables).
HARNESS_SESSION_SWEEP_SECONDS=30
# Stops runs whose workspace was archived or deleted (0 disables).
HARNESS_WORKSPACE_SWEEP_SECONDS=30
# Backstop sweep that purges expired BYO-runner nonces (0 disables).
HARNESS_RUNNER_NONCE_PURGE_SECONDS=600
# Read by section5/.../byo_runner.py ON THE CUSTOMER HOST, not by any harness service: the
# one-time hrn_ token shown at runner registration. Never on argv, never in a compose file.
# Leave empty here; the runner exits 2 without it.
HARNESS_RUNNER_TOKEN=
# Spend percentage that triggers budget warnings (default 80; values outside
# (0,100) disable the warning tier).
HARNESS_TEAM_BUDGET_WARN_PCT=
# FTS vs LIKE text matching; `like` forces the portable path.
HARNESS_SEARCH_ENGINE=auto
# On-disk roots for artifacts and diffs. The bytes are NOT backed up and are
# not shared between replicas; the DB rows are durable. Defaults are
# $TMPDIR/harness_artifacts and $TMPDIR/harness_diffs.
HARNESS_ARTIFACT_ROOT=
HARNESS_DIFFSTORE_ROOT=
HARNESS_EXPORT_DIR=

# --- Identity, governance and HTTP surface ---------------------------------
# Fail-closed rule: a requester may not approve their own request. Single-
# person teams opt out explicitly with 1.
HARNESS_ALLOW_SELF_APPROVAL=
# Session rows older than this are purged (days).
HARNESS_SESSION_RETENTION_DAYS=30
# Workspace residency codes a user may select, comma-separated.
HARNESS_WORKSPACE_ALLOWED_RESIDENCY=us,eu,uk,ap,ca
# Per-team workspace quota.
HARNESS_MAX_WORKSPACES_PER_TEAM=50
# Hosts a webhook may be pointed at, comma-separated. Unset = no outbound
# webhook target is admissible.
HARNESS_WEBHOOK_ALLOWED_HOSTS=
# Webhook delivery worker sleep (seconds, clamped to 1-60).
HARNESS_WEBHOOK_POLL_SECONDS=5
# Host port the UI is published on. The container always listens on 3000 and
# every doc quotes http://localhost:3000; set this only when 3000 is taken on a
# developer box (the W22 drill machine publishes on :3010 for that reason).
# HARNESS_FRONTEND_PORT=3000

# Marathon 2.0 W16 slice 4 — SIEM audit push. Hosts a team's SIEM collector may
# live on, comma-separated; HTTPS, port 443 and a public address are also
# required per URL. Unset = no collector endpoint can be registered, which is the
# safe default for an egress path that streams a team's security evidence.
HARNESS_SIEM_ALLOWED_HOSTS=
# SIEM push worker sleep (seconds, clamped to 5-300). A sink with rows still
# waiting goes again on the next tick, so this is the idle interval, not the
# delivery latency for a busy team.
HARNESS_SIEM_POLL_SECONDS=30
# Send HSTS only when the deployment really terminates TLS.
HARNESS_TLS_ENABLED=
# Base URL used inside notification emails (links to the app).
HARNESS_APP_URL=
# Default notification recipient when a request names nobody.
HARNESS_NOTIFY_EMAIL=
# NotificationWorker database poll interval (seconds).
HARNESS_NOTIFY_POLL_SECONDS=30
# Billing surface mode: unset/off/none keeps billing routes closed; `stripe`
# enables the adapter (keys stay in the Stripe section, never here).
HARNESS_BILLING=
# Periodic audit-chain anchor: path of the external sink, and its cadence in
# seconds (0 disables the task).
HARNESS_AUDIT_ANCHOR_PATH=
HARNESS_AUDIT_ANCHOR_SECONDS=300
# Base URL other services use to reach the model router.
HARNESS_MODELS_URL=http://models:8003
# SQLAlchemy pool shape for every service process.
HARNESS_DB_POOL_SIZE=8
HARNESS_DB_MAX_OVERFLOW=4
# json|console, and the level. Set per process by the shared runner.
HARNESS_LOG_FORMAT=json
HARNESS_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Service selection (set BY COMPOSE — do not put in .env)
# ----------------------------------------------------------------------------

# HARNESS_SERVICE selects which app a container boots:
# migrate|identity|github|models|orchestrator|sandbox|meeting|review
# Unset = legacy all-in-one mode. You normally never set this yourself.

# ----------------------------------------------------------------------------
# Test-only (never set in a deployed .env)
# ----------------------------------------------------------------------------
# Gates the real-Postgres integration test:
#   HARNESS_TEST_PG=1 HARNESS_DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5499/harness \
#     ../section1/.venv/bin/python -m pytest integration/test_checkpoint1.py
# HARNESS_TEST_PG=
# The two knobs below swap the machinery itself, never a policy: the worker
# module the confined engine imports, and the flag that unlocks synthesized
# (fake) model replies. Confinement/gates live in the runtime section above.
# HARNESS_ENGINE_WORKER_MODULE=harness_orchestrator.engine_worker
# HARNESS_ENV=dev

# ---------------------------------------------------------------------------
# External drills (NOT part of a normal deployment)
# ---------------------------------------------------------------------------
# OIDC SSO drill (profile sso-drill): disposable Keycloak with a drill realm.
KEYCLOAK_VERSION=26.1
KC_BOOTSTRAP_ADMIN_USERNAME=drill-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=drill-admin-password

# WAL-G / PITR drill (profile walg): disposable MinIO, pinned by digest in
# compose. Credentials are drill-only; never reuse them for real storage.
MINIO_ROOT_USER=harnessdrill
MINIO_ROOT_PASSWORD=harness-drill-secret
WALG_DRILL_BUCKET=harness-walg

# ---------------------------------------------------------------------------
# SLO eligibility + cross-replica index admission (added for W15 knob coverage)
# ---------------------------------------------------------------------------
# When 1/true/on: requests received during this window are EXCLUDED from SLO
# outcome eligibility (both the orchestrator's _classify_eligible and the
# synthetic observability classifier) — a declared, announced maintenance
# window that keeps drills and upgrades out of the error budget.
# Unset/0 = normal classification.
HARNESS_MAINTENANCE_MODE=
# Section 11 context-index admission: how long a replica's reservation lease
# on an indexing unit is held before another replica may take it (seconds).
# Guards the cross-process reservation table, not the queue order.
# Code default: 900.
HARNESS_INDEX_LEASE_SECONDS=900
# Deploy tag stamp (compose names images v$HARNESS_IMAGE_TAG, e.g. vv90r5).
# At runtime the compliance evidence pack (GET /api/v1/audit/pack) reads it
# only to record which build produced the trail, as manifest provenance.
# Code default: unset (manifest revision = null).
HARNESS_IMAGE_TAG=
