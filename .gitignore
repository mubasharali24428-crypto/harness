# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
build/
dist/
# Exception: the TypeScript client's compiled output IS the published artifact
# (installed straight from git), so it stays tracked. Ignoring it while tracked
# made `git add clients/ts/dist` a silent no-op after a rebuild — the drift
# `make check-ts-dist` now guards.
!clients/ts/dist/

# Node / Next.js
node_modules/
.next/
tsconfig.tsbuildinfo
next-env.d.ts

# Build & tooling caches
.pack.gz
*.tsbuildinfo

# Env & secrets — never commit
.env
.env.*
!.env.example

# DSH runtime state
task0/workspace/
task0/sessions/

# Demo seed session state (bearer token) — never commit
.seed_session.json

# Local debug/probe logs (repo root only)
/*.log

# macOS Finder metadata
.DS_Store
clients/vscode/*.vsix
