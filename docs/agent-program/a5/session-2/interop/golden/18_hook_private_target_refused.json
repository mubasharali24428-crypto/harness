{
  "name": "hook_private_target_refused",
  "request": {
    "method": "POST",
    "path": "/api/v1/extensions/hooks",
    "identity": "engineer@team-a",
    "body": {
      "name": "refused",
      "eventType": "tool_call.succeeded",
      "target": {
        "kind": "webhook",
        "url": "http://10.0.0.1/wiki"
      }
    }
  },
  "response": {
