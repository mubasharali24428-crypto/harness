 "info": {
  "description": "API fragment for the human-in-the-loop review and merge gate. The app itself never merges \u2014 merge is always a manual GitHub action.",
  "title": "Section 8: Review Area API",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/reviews/settings/thresholds": {
   "get": {
    "description": "Read-only view of the caller's team reviewer thresholds (M15-G6b).\n\nThe AUTHORITATIVE admin write path is Section 1's\n``GET/PUT /api/v1/teams/{teamId}/settings/reviewer-thresholds``; this\nendpoint exists so the Review Area UI can show what's in force without\nreaching across sections. Missing config answers the documented defaults\n(never an error).",
    "operationId": "get_reviewer_threshold_settings_api_v1_reviews_settings_thresholds_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Get Reviewer Threshold Settings Api V1 Reviews Settings Thresholds Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Get Reviewer Threshold Settings"
   }
  },
  "/api/v1/reviews/{pr_id}": {
   "get": {
    "operationId": "get_review_api_v1_reviews__pr_id__get",
    "parameters": [
     {
      "in": "path",
      "name": "pr_id",
      "required": true,
      "schema": {
       "title": "Pr Id",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "diff_text",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
