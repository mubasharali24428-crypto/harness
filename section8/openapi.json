     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ReviewDataResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Get Review"
   }
  },
