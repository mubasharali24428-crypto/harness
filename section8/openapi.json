{
  "openapi": "3.0.3",
  "info": {
    "title": "Section 8: Review Area API",
    "version": "0.1.0",
    "description": "API fragment for the human-in-the-loop review and merge gate. The app itself never merges — merge is always a manual GitHub action."
  },
  "paths": {
    "/api/v1/reviews/{prId}": {
      "get": {
        "summary": "Get full review data for a PR (diff, changed files, risk flags, AI summary, comments, test results)",
        "operationId": "getReview",
        "parameters": [
          { "name": "prId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "diff_text", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Full review data payload" },
          "404": { "description": "PR not found" },
          "500": { "description": "Internal error" }
        }
      }
    },
    "/api/v1/reviews/{prId}/approve": {
      "post": {
        "summary": "Approve a PR for merge (does NOT auto-merge on GitHub)",
        "operationId": "approvePr",
        "parameters": [
          { "name": "prId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reviewer_user_id"],
                "properties": {
                  "reviewer_user_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "PR approved" },
          "404": { "description": "PR not found" }
        }
      }
    },
    "/api/v1/reviews/{prId}/request-changes": {
      "post": {
        "summary": "Request changes on a PR with inline comments",
        "operationId": "requestChanges",
        "parameters": [
          { "name": "prId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reviewer_user_id"],
                "properties": {
                  "reviewer_user_id": { "type": "string" },
                  "comments": {
                    "type": "array",
                    "items": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Changes requested" },
          "404": { "description": "PR not found" }
        }
      }
    },
    "/api/v1/reviews/{prId}/comments": {
      "post": {
        "summary": "Add an inline review comment to a PR",
        "operationId": "addComment",
        "parameters": [
          { "name": "prId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["body"],
                "properties": {
                  "file_path": { "type": "string" },
                  "line": { "type": "integer" },
                  "body": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Comment created" },
          "404": { "description": "PR not found" }
        }
      }
    },
    "/api/v1/reviews/{prId}/comments": {
      "get": {
        "summary": "List all inline review comments on a PR",
        "operationId": "listComments",
        "parameters": [
          { "name": "prId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of comments" }
        }
      }
    },
    "/api/v1/reviews/{prId}/risks": {
      "get": {
        "summary": "Get high-risk zone flags for a PR's changed files",
        "operationId": "getRiskFlags",
        "parameters": [
          { "name": "prId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of risk flags" },
          "404": { "description": "PR not found" }
        }
      }
    },
    "/api/v1/reviews/{prId}/deep-link": {
      "get": {
        "summary": "Get deep-link URL to GitHub's PR merge page (merge is always manual)",
        "operationId": "deepLink",
        "parameters": [
          { "name": "prId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "GitHub deep-link URL" },
          "404": { "description": "PR not found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReviewDataResponse": {
        "type": "object",
        "required": [
          "prId", "projectId", "githubPrNumber", "prUrl", "headBranch",
          "baseBranch", "state", "reviewStatus", "diff", "changedFiles",
          "riskFlags", "reviewComments", "testResults"
        ],
        "properties": {
          "prId": { "type": "string" },
          "projectId": { "type": "string" },
          "githubPrNumber": { "type": "integer" },
          "prUrl": { "type": "string" },
          "headBranch": { "type": "string" },
          "baseBranch": { "type": "string" },
          "state": { "type": "string" },
          "reviewStatus": { "type": "string", "enum": ["pending", "approved", "changes_requested"] },
          "approvedBy": { "type": "string", "nullable": true },
          "diff": { "type": "string" },
          "changedFiles": { "type": "array", "items": { "$ref": "#/components/schemas/ChangedFile" } },
          "unchangedAreasNote": { "type": "string", "nullable": true },
          "riskFlags": { "type": "array", "items": { "$ref": "#/components/schemas/RiskFlag" } },
          "summary": { "type": "object", "nullable": true },
          "reviewComments": { "type": "array", "items": { "type": "object" } },
          "testResults": { "type": "array", "items": { "type": "object" } }
        }
      },
      "ChangedFile": {
        "type": "object",
        "required": ["path", "status"],
        "properties": {
          "path": { "type": "string" },
          "status": { "type": "string", "enum": ["added", "modified", "removed", "renamed"] },
          "additions": { "type": "integer" },
          "deletions": { "type": "integer" },
          "rename_from": { "type": "string", "nullable": true }
        }
      },
      "RiskFlag": {
        "type": "object",
        "required": ["path", "severity", "rule", "reason"],
        "properties": {
          "path": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "rule": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
