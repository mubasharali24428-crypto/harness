 "info": {
  "title": "harness-identity",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/auth/login": {
   "post": {
    "operationId": "login_api_v1_auth_login_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/LoginRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SessionResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "401": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorEnvelope"
        }
       }
      },
      "description": "bad or missing credentials"
     },
     "403": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorEnvelope"
        }
       }
      },
      "description": "ownership proof required (H2r)"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     },
     "429": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorEnvelope"
        }
       }
      },
      "description": "login rate limit exceeded"
     }
    },
    "summary": "Login"
   }
  },
  "/api/v1/auth/logout": {
   "post": {
    "description": "Revoke the presenting session immediately.",
    "operationId": "logout_api_v1_auth_logout_post",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OkResponse"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Logout"
   }
  },
  "/api/v1/auth/request-login": {
   "post": {
    "operationId": "request_login_api_v1_auth_request_login_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/LoginRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OkResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Request Login"
   }
  },
  "/api/v1/auth/verify-otp": {
   "post": {
    "operationId": "verify_otp_route_api_v1_auth_verify_otp_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/VerifyOtpRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SessionResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "401": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorEnvelope"
        }
       }
      },
      "description": "OTP invalid, expired or already redeemed"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Verify Otp Route"
   }
  },
  "/api/v1/billing/plan": {
   "put": {
    "description": "Upsert the team's billing_plans row (admin-only) and return the state.",
    "operationId": "update_billing_plan_api_v1_billing_plan_put",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PlanUpdateBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Update Billing Plan Api V1 Billing Plan Put",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Update Billing Plan"
   }
  },
  "/api/v1/billing/state": {
   "get": {
    "description": "Current billing state for the caller's team (any authenticated role).",
    "operationId": "billing_state_api_v1_billing_state_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Billing State Api V1 Billing State Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Billing State"
   }
  },
  "/api/v1/csp-report": {
   "post": {
    "description": "Accept a browser CSP violation report (204, no content).",
    "operationId": "collect_csp_report_api_v1_csp_report_post",
    "responses": {
     "204": {
      "description": "Successful Response"
     }
    },
    "summary": "Collect Csp Report"
   }
  },
  "/api/v1/invites/redeem": {
   "post": {
    "description": "Any authed user redeems a token and joins the invited team with the\ninvited role. Atomic single-statement claim: expired/redeemed/unknown are\nrejected with honest codes; membership insert rides the same transaction.",
    "operationId": "redeem_invite_api_v1_invites_redeem_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/InviteRedeemBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Redeem Invite Api V1 Invites Redeem Post",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Redeem Invite"
   }
  },
  "/api/v1/keys": {
   "get": {
    "description": "List the caller's team keys (hint only, never the raw key).\n\n?teamId= is honored only when it matches the caller's membership \u2014\nanything else answers 404 NOT_FOUND, identical to an unknown team id\n(M13-G5a no-oracle law; was 403 FORBIDDEN).",
    "operationId": "list_keys_api_v1_keys_get",
    "parameters": [
     {
      "in": "query",
      "name": "teamId",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Teamid"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/KeyListResponse"
        }
       }
      },
      "description": "Successful Response"
