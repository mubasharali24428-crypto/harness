 "paths": {
  "/api/v1/github/connection": {
   "get": {
    "operationId": "connection_status_api_v1_github_connection_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Connection Status Api V1 Github Connection Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Connection Status"
   }
  },
  "/api/v1/github/disconnect": {
   "post": {
    "description": "S1-R02f: revoke this user's stored GitHub OAuth token(s) at rest.\n\nDeletes every ``github_connections`` row for the caller so the harness can\nno longer act against GitHub on their behalf; the response reports exactly\nhow many rows were removed. Revoking the OAuth grant on GitHub's own side\nis a separate operator step (see S1-R02 note).",
    "operationId": "disconnect_github_api_v1_github_disconnect_post",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Disconnect Github Api V1 Github Disconnect Post",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Disconnect Github"
   }
  },
  "/api/v1/github/oauth/callback": {
   "get": {
    "description": "No auth here \u2014 the browser returns from GitHub carrying our `state`,\nwhich is the CSRF binding back to the initiating user.",
    "operationId": "oauth_callback_api_v1_github_oauth_callback_get",
    "parameters": [
     {
      "in": "query",
      "name": "code",
      "required": true,
      "schema": {
       "title": "Code",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "state",
      "required": true,
      "schema": {
       "title": "State",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Oauth Callback"
   }
  },
  "/api/v1/github/oauth/start": {
   "get": {
    "description": "Browser entry: 302 to GitHub's authorize URL with a CSRF state bound to\nthe session user. Browsers cannot send Authorization headers on navigation,\nso the frontend fetches a one-time start-ticket first; API clients may use\na bearer token directly.",
    "operationId": "oauth_start_api_v1_github_oauth_start_get",
    "parameters": [
     {
      "in": "query",
      "name": "ticket",
      "required": false,
      "schema": {
       "default": "",
       "title": "Ticket",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Oauth Start"
   }
  },
  "/api/v1/github/oauth/start-ticket": {
   "post": {
    "description": "One-time 60s hop for browser navigation (no headers on window.location).",
    "operationId": "oauth_start_ticket_api_v1_github_oauth_start_ticket_post",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Oauth Start Ticket Api V1 Github Oauth Start Ticket Post",
