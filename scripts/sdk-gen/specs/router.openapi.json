    ],
    "title": "SpendErrorDetail",
    "type": "object"
   },
   "SpendErrorEnvelope": {
    "properties": {
     "error": {
      "$ref": "#/components/schemas/SpendErrorDetail"
     }
    },
    "required": [
     "error"
    ],
    "title": "SpendErrorEnvelope",
    "type": "object"
   },
   "SpendSummaryResponse": {
    "description": "Aggregate spend from cost_ledger (mirrors ledger.summarize_spend).\n\nM14-W4 F1a (pair contract W4-C1): ``unwired`` distinguishes\nzero-because-nothing-ran from zero-because-unmetered. It is False whenever\nthe ledger is connected and queryable (even at zero rows \u2014 the numbers are\nthen genuinely zero, not unknown) and the route keeps answering 503\nLEDGER_UNAVAILABLE only when NO metering config exists, so the field never\ncontradicts the HTTP status.",
    "properties": {
     "byDay": {
      "items": {
       "$ref": "#/components/schemas/SpendByDay"
      },
      "title": "Byday",
      "type": "array"
     },
     "byModel": {
      "items": {
       "$ref": "#/components/schemas/SpendByModel"
      },
      "title": "Bymodel",
      "type": "array"
     },
     "totals": {
      "$ref": "#/components/schemas/SpendTotals"
     },
     "unattributed": {
      "$ref": "#/components/schemas/UnattributedSpend"
     },
     "unwired": {
      "default": false,
      "title": "Unwired",
      "type": "boolean"
     }
    },
    "required": [
     "totals",
     "unattributed"
    ],
    "title": "SpendSummaryResponse",
    "type": "object"
   },
   "SpendTotals": {
    "description": "M13-G5a typing island: spend totals block (camelCase wire shape).",
    "properties": {
     "costUsd": {
      "title": "Costusd",
      "type": "number"
     },
     "inputTokens": {
      "title": "Inputtokens",
      "type": "integer"
     },
     "outputTokens": {
      "title": "Outputtokens",
      "type": "integer"
     }
    },
    "required": [
     "inputTokens",
     "outputTokens",
     "costUsd"
    ],
    "title": "SpendTotals",
    "type": "object"
   },
   "UnattributedSpend": {
    "description": "Ledger calls with no run; never presented as team-owned spend.",
    "properties": {
     "calls": {
      "title": "Calls",
      "type": "integer"
     },
     "costUsd": {
      "title": "Costusd",
      "type": "number"
     },
     "inputTokens": {
      "title": "Inputtokens",
      "type": "integer"
     },
     "outputTokens": {
      "title": "Outputtokens",
      "type": "integer"
     }
    },
    "required": [
     "calls",
     "inputTokens",
     "outputTokens",
     "costUsd"
    ],
    "title": "UnattributedSpend",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
