       "low",
       "medium",
       "high"
      ],
      "title": "Reasoningeffort",
      "type": "string"
     },
     "reviewerModel": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Reviewermodel",
      "type": "string"
     }
    },
    "required": [
