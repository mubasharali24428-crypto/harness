      "title": "Model",
      "type": "string"
     },
     "role": {
      "$ref": "#/components/schemas/ModelRole"
     }
    },
    "required": [
     "role",
     "model"
    ],
    "title": "ConfigureRoleModelRequest",
    "type": "object"
   },
   "EstimateCostRequest": {
    "properties": {
     "inputTokens": {
      "minimum": 0.0,
      "title": "Inputtokens",
      "type": "integer"
     },
     "model": {
