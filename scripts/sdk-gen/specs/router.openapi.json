  "/api/v1/models/spend": {
   "get": {
    "description": "Aggregated spend from cost_ledger: totals, per-model and per-day.\n\nTeam-scoped (S1-R01a): every caller is locked to ``principal.teamId``;\nan explicit foreign ``teamId`` is denied with 403.\n\nM14-W4 F1a (W4-C1): a wired, queryable ledger answers 200 with\n``unwired=False`` \u2014 even when zero rows exist, the zeros are REAL zeros\n(metering is live; nothing ran). ``unwired`` therefore never appears as\ntrue in a 200 body: the unwired case is the 503 LEDGER_UNAVAILABLE branch\nbelow, which fires only when no metering config (ledger pool) exists.",
    "operationId": "model_spend_api_v1_models_spend_get",
    "parameters": [
     {
      "in": "query",
      "name": "teamId",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Teamid"
      }
     },
     {
      "in": "query",
      "name": "projectId",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Projectid"
      }
     },
     {
      "in": "query",
      "name": "sinceDays",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "title": "Sincedays"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SpendSummaryResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     },
     "503": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SpendErrorEnvelope"
        }
       }
      },
      "description": "LEDGER_UNAVAILABLE \u2014 cost ledger pool not wired"
     }
    },
    "summary": "Model Spend",
    "tags": [
     "models"
    ]
   }
  },
