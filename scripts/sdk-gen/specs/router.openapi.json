      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "ModelCallOpts": {
    "properties": {
     "extra": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Extra"
     },
     "maxTokens": {
      "default": 4096,
      "title": "Maxtokens",
      "type": "integer"
     },
