      "title": "Costusd",
      "type": "number"
     },
     "latencyMs": {
      "title": "Latencyms",
      "type": "integer"
     },
     "model": {
      "title": "Model",
      "type": "string"
     },
     "text": {
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
