  "/api/v1/models/metrics": {
   "get": {
    "description": "PUBLIC Prometheus endpoint \u2014 no auth dep, like /health.\n\nDeliberately public: this is the Prometheus scrape target (S1-R01a\nresidual R-13 \u2014 route-count enumeration only, no spend/data leakage).",
    "operationId": "prometheus_metrics_api_v1_models_metrics_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Prometheus Metrics",
    "tags": [
     "models"
    ]
   }
  },
  "/api/v1/models/prefs": {
   "get": {
    "description": "The team's saved role models + reasoning effort (defaults when unset).",
    "operationId": "get_model_prefs_api_v1_models_prefs_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Get Model Prefs Api V1 Models Prefs Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Get Model Prefs",
    "tags": [
     "models"
    ]
   },
   "put": {
    "description": "Admin-only durable update. Also applies the choice to this process.",
    "operationId": "put_model_prefs_api_v1_models_prefs_put",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ModelPrefsBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Put Model Prefs Api V1 Models Prefs Put",
         "type": "object"
        }
       }
