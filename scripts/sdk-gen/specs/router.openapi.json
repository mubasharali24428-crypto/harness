{
 "components": {
  "schemas": {
   "CallModelRequest": {
    "properties": {
     "agentId": {
      "title": "Agentid",
      "type": "string"
     },
     "apiKey": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Apikey"
     },
     "messages": {
      "items": {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      "title": "Messages",
      "type": "array"
     },
     "model": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Model"
     },
     "opts": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/ModelCallOpts"
       },
       {
        "type": "null"
       }
      ]
     },
     "role": {
      "$ref": "#/components/schemas/ModelRole"
     },
     "runId": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Runid"
     }
    },
    "required": [
     "agentId",
     "role",
     "messages"
    ],
    "title": "CallModelRequest",
    "type": "object"
   },
   "ConfigureRoleModelRequest": {
    "properties": {
