     "costUsd",
     "model",
     "latencyMs"
    ],
    "title": "ModelResult",
    "type": "object"
   },
   "ModelRole": {
    "enum": [
     "primary",
     "reviewer"
    ],
    "title": "ModelRole",
    "type": "string"
   },
   "SpendByDay": {
    "properties": {
     "costUsd": {
      "title": "Costusd",
      "type": "number"
     },
     "day": {
      "title": "Day",
      "type": "string"
     }
    },
    "required": [
