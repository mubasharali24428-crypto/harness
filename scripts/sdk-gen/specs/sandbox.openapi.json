      "title": "Name",
      "type": "string"
     },
     "size": {
      "minimum": 0.0,
      "title": "Size",
      "type": "integer"
     },
     "type": {
      "pattern": "^(file|dir)$",
      "title": "Type",
      "type": "string"
     }
    },
    "required": [
     "name",
     "type",
     "size"
    ],
    "title": "TreeEntry",
    "type": "object"
   },
