      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "HunkRef": {
    "properties": {
     "index": {
      "minimum": 0.0,
      "title": "Index",
      "type": "integer"
     },
     "path": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Path",
      "type": "string"
     }
    },
    "required": [
     "path",
     "index"
    ],
    "title": "HunkRef",
    "type": "object"
   },
   "RevertHunksRequest": {
    "properties": {
     "hunks": {
      "items": {
       "$ref": "#/components/schemas/HunkRef"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Hunks",
      "type": "array"
     }
    },
    "required": [
     "hunks"
    ],
    "title": "RevertHunksRequest",
    "type": "object"
   },
   "StructuredExecResult": {
    "properties": {
     "diagnostics": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
     },
     "duration_ms": {
      "default": 0,
      "title": "Duration Ms",
      "type": "integer"
     },
     "exit_code": {
      "title": "Exit Code",
      "type": "integer"
     },
     "failed_count": {
      "default": 0,
      "title": "Failed Count",
      "type": "integer"
     },
     "passed_count": {
      "default": 0,
      "title": "Passed Count",
      "type": "integer"
     },
     "skipped_count": {
      "default": 0,
      "title": "Skipped Count",
      "type": "integer"
     },
     "status": {
      "enum": [
       "passed",
       "failed",
       "error"
      ],
      "title": "Status",
      "type": "string"
     },
     "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
     }
    },
    "required": [
     "status",
     "exit_code"
    ],
    "title": "StructuredExecResult",
    "type": "object"
   },
   "TaskHandle": {
    "properties": {
