      "title": "Branch",
      "type": "string"
     },
     "containerId": {
      "title": "Containerid",
      "type": "string"
     },
     "taskId": {
      "title": "Taskid",
      "type": "string"
     }
    },
    "required": [
     "taskId",
     "containerId",
     "branch"
    ],
    "title": "TaskHandle",
    "type": "object"
   },
