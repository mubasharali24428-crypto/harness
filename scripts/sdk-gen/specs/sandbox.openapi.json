      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Projectid"
     },
     "repoRef": {
      "title": "Reporef",
      "type": "string"
     },
     "resume": {
      "default": false,
