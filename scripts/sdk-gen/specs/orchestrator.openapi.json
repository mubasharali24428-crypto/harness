 "info": {
  "title": "harness-orchestrator",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/orchestrator/plans": {
   "post": {
    "description": "{goal} \u2192 201 {planId, plan}. Mints a fresh run + plan, leaves the run at\nAWAITING_PLAN_APPROVAL via sm.plan_proposed() (state_machine vocabulary).",
    "operationId": "propose_plan_api_v1_orchestrator_plans_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ProposePlanGateRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PlanProposedResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/_ErrorEnvelope"
        }
       }
      },
      "description": "INVALID_STATE"
     },
     "403": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/_ErrorEnvelope"
        }
       }
      },
      "description": "ROLE_DENIED"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Propose Plan",
    "tags": [
     "plan-gate"
    ]
   }
  },
  "/api/v1/orchestrator/plans/{planId}/approve": {
   "post": {
    "description": "`/plans/{id}/approve` \u2192 200 {runId}. admin/engineer only. Idempotent.\n\nM12-F2: the durable decision is a compare-and-swap on agent_plans.version.\nThe CAS runs BEFORE any in-memory mutation, so a loser of the race leaves\nplanner/state-machine/memory untouched and gets 409 PLAN_ALREADY_DECIDED\ninstead of both callers believing they won (last-write-wins eliminated).\nA sequential re-approve still short-circuits to the same runId.",
    "operationId": "approve_plan_api_v1_orchestrator_plans__planId__approve_post",
    "parameters": [
     {
      "in": "path",
      "name": "planId",
      "required": true,
      "schema": {
       "title": "Planid",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PlanActionResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "403": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/_ErrorEnvelope"
        }
       }
      },
      "description": "ROLE_DENIED"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/_ErrorEnvelope"
        }
       }
      },
      "description": "PLAN_NOT_FOUND"
     },
     "409": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/_ErrorEnvelope"
        }
       }
      },
      "description": "PLAN_ALREADY_DECIDED / INVALID_STATE"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Approve Plan",
    "tags": [
     "plan-gate"
    ]
   }
  },
  "/api/v1/orchestrator/plans/{planId}/reject": {
   "post": {
    "description": "`/plans/{id}/reject` \u2192 202. Persisted AND audited. admin/engineer only.\n\nM12-F2: same CAS-before-memory discipline as approve. The decision window\nis AWAITING_PLAN_APPROVAL \u2014 a plan that already moved (approved, rejected,\nexecuting) rejects with 409 PLAN_ALREADY_DECIDED, so reject-after-reject\nand mixed approve/reject races resolve to exactly one winner.",
    "operationId": "reject_plan_api_v1_orchestrator_plans__planId__reject_post",
    "parameters": [
     {
      "in": "path",
      "name": "planId",
      "required": true,
      "schema": {
       "title": "Planid",
       "type": "string"
      }
     }
    ],
    "responses": {
     "202": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PlanRejectedResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "403": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/_ErrorEnvelope"
        }
       }
      },
      "description": "ROLE_DENIED"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/_ErrorEnvelope"
        }
       }
      },
      "description": "PLAN_NOT_FOUND"
     },
     "409": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/_ErrorEnvelope"
        }
       }
      },
      "description": "PLAN_ALREADY_DECIDED / INVALID_STATE"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Reject Plan",
    "tags": [
     "plan-gate"
    ]
   }
  },
  "/api/v1/orchestrator/runs": {
   "get": {
    "description": "List the caller's team's runs, newest first (contract M10-C2).\n\nCursor pagination per api-conventions.md: pass ``nextCursor`` back as\n``?cursor=`` for the next page. ``?offset=`` is accepted but IGNORED\nduring the one-release deprecation window (M14-W4 F3a).",
    "operationId": "list_runs_api_v1_orchestrator_runs_get",
    "parameters": [
     {
      "in": "query",
      "name": "projectId",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Projectid"
      }
     },
     {
      "in": "query",
      "name": "status",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
