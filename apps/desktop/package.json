{
  "name": "harness-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Thin, locked-down desktop shell for the Harness web app.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run test/unit",
    "smoke": "npm run build && playwright test -c playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "electron": "^44.9.0",
    "esbuild": "0.25.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
